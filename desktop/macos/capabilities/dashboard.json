{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "dashboard-window",
  "description": "The local dashboard can drag and maximize its native window.",
  "windows": [
    "dashboard"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:*/*",
      "http://localhost:*/*",
      "http://[\\:\\:1]:*/*"
    ]
  },
  "permissions": [
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize"
  ]
}
