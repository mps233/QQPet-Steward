{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QQPet-Steward",
  "version": "0.8.7",
  "identifier": "ai.qqpet.dashboard.desktop",
  "build": {
    "frontendDist": "app"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "launcher",
        "title": "QQPet-Steward",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "url": "index.html",
        "width": 460,
        "height": 680,
        "minWidth": 380,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": [
          "'self'",
          "http://127.0.0.1:*",
          "http://localhost:*",
          "http://*",
          "https://*"
        ],
        "img-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.icns"
    ],
    "category": "Utility",
    "shortDescription": "QQPet-Steward for macOS",
    "longDescription": "An integrated local app with the dashboard, Python runtime, device tools, and scheduler included.",
    "resources": {
      "target/runtime/QQPetRuntime/": "backend/"
    },
    "macOS": {
      "minimumSystemVersion": "26.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA1MUREODY4RTExN0Y4MEIKUldRTCtCZmhhTmdkQmRsRHNtY05CejYrSXBMMzJwQXlnQ04rcE92ajA0dTdTekJicjBlNGlRTWYK",
      "endpoints": [
        "https://github.com/mps233/QQPet-Steward/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
